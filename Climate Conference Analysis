**Query #5**

    --5 Multiple Joins- Shows VIPs their events , and the hotels they reserved
    
    SELECT
        v1.first_name,
        v1.last_name,
        v2.first_name,
        v2.last_name,
        v1.event
    FROM vips v1
    INNER JOIN vips v2
        ON v1.event = v2.event
    WHERE v1.member_id < v2.member_id;

