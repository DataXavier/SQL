WITH inventory AS (
 SELECT 101 AS product_id, 'Laptop' AS product_name, 'Electronics' AS category, 899.99 AS price, 25 AS stock_quantity
 UNION ALL SELECT 102, 'Office Chair', 'Furniture', 149.99, 40
 UNION ALL SELECT 103, 'Laptop', 'Electronics', 899.99, 25
 UNION ALL SELECT 104, 'Desk', 'Furniture', CAST(NULL AS FLOAT64), 12
 UNION ALL SELECT 105, 'Keyboard', 'Accessories', 49.99, 0
 UNION ALL SELECT 106, 'Mouse', 'Accessories', 19.99, 75
)
SELECT
 product_name,
 price,
 stock_quantity
FROM inventory;


